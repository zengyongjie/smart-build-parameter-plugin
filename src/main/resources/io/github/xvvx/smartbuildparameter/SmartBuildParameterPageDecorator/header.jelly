    <link rel="stylesheet" href="${rootURL}/plugin/smart-build-parameter-plugin/css/smart-build-page.css" type="text/css"/>
    <script src="${rootURL}/plugin/smart-build-parameter-plugin/js/smart-build-page.js" defer="defer"></script>
  </j:if>
</j:jelly>
